// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Yerel geliştirme: "sqlite" | Production (Neon): "postgresql"
// URL prisma.config.ts'de tanımlanır
datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER or ADMIN
  
  accounts      Account[]
  sessions      Session[]
  readProgress  ReadProgress[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReadProgress {
  id           String   @id @default(cuid())
  userId       String
  slug         String   // Sohbet slug
  progress     Int      // Percentage (0-100)
  sectionId    String?  // Kaldığı bölümün HTML ID'si (Örn: bolum-2)
  sectionTitle String?  // Kaldığı bölümün başlığı
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

// ---------------------------------------------------------------------------
// İçerik Modelleri — Sohbet ve Kavram
// ---------------------------------------------------------------------------

model SohbetRecord {
  id              String   @id @default(cuid())
  slug            String   @unique
  dosyaAdi        String   // "Başlık.md"
  baslik          String
  konu            String   @default("")
  ozet            String   @default("")
  kavramlarRaw    String   @default("")  // virgülle ayrılmış ham kavram listesi
  vurgularJson    String   @default("[]") // JSON array string
  ayetlerNotu     String   @default("")
  ayetlerJson     String   @default("[]") // JSON array of AyetRef
  bolumlerJson    String   @default("[]") // JSON array of Bolum
  govde           String   // markdown gövde (başlık bloğu çıkarılmış)
  rawContent      String   // orijinal tam markdown dosya içeriği
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KavramRecord {
  id       String  @id @default(cuid())
  slug     String  @unique
  ad       String
  kisaAd   String?
  aliases  String  @default("[]") // JSON array string
}
